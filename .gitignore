# dependencies
node_modules/
.bun/

# build output
dist/
build/
web-build/
out/
*.tsbuildinfo

# expo (per-app .gitignore covers generated native folders)
.expo/
expo-env.d.ts
.metro-health-check*

# native secrets
*.orig.*
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# test / coverage
coverage/
.nyc_output/
test-results/
playwright-report/

# debug / logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# env
.env
.env.*
!.env.example

# scratch / local data
tmp/
# Ad-hoc screenshots from a manual browser check. Playwright's own baselines
# live in e2e/screenshots/ and are committed; anything at the repo root is
# throwaway.
/*.png

# caches
.cache/
.turbo/
.eslintcache

# os
.DS_Store
Thumbs.db

# editor
.idea/
*.swp
.playwright-mcp

# claude
.claude/worktree
.claude/settings.local.json

ios/Pods
